        <component refId="c" componentClassID="Microsoft.ManagedComponentHost" name="Script Clean"><properties><property name="UserComponentTypeName">Microsoft.SqlServer.Dts.Pipeline.ScriptComponentHost, Microsoft.SqlServer.TxScript, Version=16.0.0.0</property></properties></component>
        <component refId="d" componentClassID="Microsoft.OLEDBDestination" name="Write DW" connectionManagerID="{22222222-0000-0000-0000-000000000002}:external" />
