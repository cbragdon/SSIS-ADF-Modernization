    <DTS:Executable DTS:refId="Package\Archive and notify" DTS:ExecutableType="Microsoft.ScriptTask" DTS:ObjectName="Archive and notify">
      <DTS:ObjectData>
        <ScriptProject Name="ST_ArchiveNotify" VSTAMajorVersion="17" VSTAMinorVersion="0" Language="CSharp">
          <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[using System;
using System.Data.SqlClient;
using System.Diagnostics;
using System.IO;
// using Microsoft.Office.Interop.Excel;
using Acme.Etl.Helpers;

public partial class ScriptMain
{
    public void Main()
    {
        string drop = @"\\fileserver\drop\";
        foreach (string f in Directory.GetFiles(drop, "*.csv"))
        {
            File.Move(f, Path.Combine(drop, "archive", Path.GetFileName(f)));
        }
        /* Process.Start would be flagged if this block were live, but the External process
           dependency comes from the call below. */
        Process.Start("7z.exe", "a archive.7z *.csv");
        using (SqlConnection cn = new SqlConnection(Dts.Variables["User::AuditConn"].Value.ToString()))
        {
            cn.Open();
        }
        Notifier.Send("archive complete");
    }
}
]]></ProjectItem>
