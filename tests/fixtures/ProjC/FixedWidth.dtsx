  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[Mainframe extract]" DTS:CreationName="FLATFILE" DTS:DTSID="{C0000011-0000-0000-0000-000000000001}" DTS:ObjectName="Mainframe extract">
